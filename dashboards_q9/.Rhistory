library(tidytext)
library(RColorBrewer)
wordcloud <- function(df, column)
{
pal <- brewer.pal(8, "Dark2")
df |> unnest_tokens(input = !!sym(column), output = word) |>
anti_join(get_stopwords()) |>
count(word, sort = TRUE) |>
with(wordcloud::wordcloud(word, n, random.order = FALSE, max.words = 50, colors = pal))
}
