# Function
accuracy <- function(df, train_percent = 0.8)
{
library(caret)
set.seed(00000)
splitIndex <- createDataPartition(df$target, p = train_percent,
list = FALSE)
df_train <- df[ splitIndex,]
df_test <- df[-splitIndex,]
library(rpart)
tree1<-rpart(target ~ .,
data = df_train)
pred <- predict(tree1, df_test, type = "class")
cm <- confusionMatrix(data = pred, reference = df_test$target)
return(cm$overall[1])
}
accuracy(df_model)
accuracy(df_model, 0.7)
var_imp <- function(df, train_percent = 0.8)
{
library(caret)
set.seed(00000)
splitIndex <- createDataPartition(df$target, p = train_percent,
list = FALSE)
df_train <- df[ splitIndex,]
df_test <- df[-splitIndex,]
library(rpart)
tree1<-rpart(target ~ .,
data = df_train)
pred <- predict(tree1, df_test, type = "class")
cm <- confusionMatrix(data = pred, reference = df_test$target)
return(barplot(tree1$variable.importance))
}
