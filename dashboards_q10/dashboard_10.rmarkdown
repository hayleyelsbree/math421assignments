```{r}
#| context: setup
library(shiny)
library(tidyverse)
library(plotly)
library(DT)
library(lubridate)
df <- read_csv("flight_data_2024.csv") |> mutate(fl_date = ymd(fl_date), across(where(is.character), as.factor))
df$carrier <- case_when(df$op_unique_carrier == "9E" ~ "Endeavor Air",
                       df$op_unique_carrier == "AA" ~ "American Airlines",
                       df$op_unique_carrier == "AS" ~ "Alaska Airlines",
                       df$op_unique_carrier == "B6" ~ "JetBlue Airways",
                       df$op_unique_carrier == "DL" ~ "Delta Air Lines",
                       df$op_unique_carrier == "F9" ~ "Frontier Airlines",
                       df$op_unique_carrier == "G4" ~ "Allegiant Air",
                       df$op_unique_carrier == "HA" ~ "Hawaiian Airlines",
                       df$op_unique_carrier == "MQ" ~ "Envoy Air",
                       df$op_unique_carrier == "NK" ~ "Spirit Airlines",
                       df$op_unique_carrier == "OH" ~ "PSA Airlines",
                       df$op_unique_carrier == "OO" ~ "SkyWest Airlines",
                       df$op_unique_carrier == "UA" ~ "United Airlines",
                       df$op_unique_carrier == "WN" ~ "Southwest Airlines",
                       df$op_unique_carrier == "YX" ~ "Republic Airways")

set.seed(42)
small_df <- df |> slice_sample(prop = 0.01)

# Shown instead of a plot when the inputs leave no rows
empty_plot <- function() {
  plotly_empty() |>
    layout(title = list(text = "No flights match these inputs.", y = 0.5))
}
```


# Overview

## {.sidebar}

With the holiday season approaching, airline delays are a major worry amongst travelers in the US. This dashboard analyzes flight delays, cancellations, and on-time performance across major US airports in 2024.

Use the filters below to explore different aspects of airline performance.

Learn more about the dataset on Kaggle: [flight_data_2024](https://www.kaggle.com/datasets/hrishitpatil/flight-data-2024)

```{r}
# Delay
selectInput("delay_type", "Delay Measure",
            choices = c(
              "Departure Delay" = "dep_delay",
              "Arrival Delay" = "arr_delay",
              "Carrier Delay" = "carrier_delay",
              "Weather Delay" = "weather_delay",
              "NAS Delay" = "nas_delay",
              "Late Aircraft Delay" = "late_aircraft_delay"
            ))

# Filter by Airline
checkboxGroupInput("carriers", "Airlines",
                   choices = c("Endeavor Air",
                               "American Airlines",
                               "Alaska Airlines",
                               "JetBlue Airways",
                               "Delta Air Lines",
                               "Frontier Airlines",
                               "Allegiant Air",
                               "Hawaiian Airlines",
                               "Envoy Air",
                               "Spirit Airlines",
                               "PSA Airlines",
                               "SkyWest Airlines",
                               "United Airlines",
                               "Southwest Airlines",
                               "Republic Airways"),
                   selected = c("Endeavor Air",
                               "American Airlines",
                               "Alaska Airlines",
                               "JetBlue Airways",
                               "Delta Air Lines",
                               "Frontier Airlines",
                               "Allegiant Air",
                               "Hawaiian Airlines",
                               "Envoy Air",
                               "Spirit Airlines",
                               "PSA Airlines",
                               "SkyWest Airlines",
                               "United Airlines",
                               "Southwest Airlines",
                               "Republic Airways"))

# Flight Distance
sliderInput("distance", "Flight Distance (Miles)",min = min(df$distance, na.rm = TRUE), max = max(df$distance, na.rm = TRUE),
            value = c(min(df$distance, na.rm = TRUE), max(df$distance, na.rm = TRUE)))

# Cancelled vs Not Cancelled
radioButtons("cancelled", "Cancellation Status",
                   choices = c("All Flights" = "all",
                               "Cancelled Only" = "1",
                               "Not Cancelled" = "0"))

# Date Range
dateRangeInput("dates", "Date Range",
               start = min(df$fl_date), end = max(df$fl_date),
               min = min(df$fl_date), max = max(df$fl_date))
```


