# Function
even_odd <- function(x)
{
if(x%%2 == 0)
{
"You input an even number!"
}
else
{
"You input an odd number!"
}
}
# Example: odd
even_odd(21)
# Example: even
even_odd(100)
# Function
library(tidyverse)
mean_impute <- function(x)
{
if(is.numeric(x))
{
# Find mean of x
mean_of_x <- mean(x, na.rm = TRUE)
x <- replace_na(x, mean_of_x)
}
return(x)
}
# Example: NA
mean_impute(c(2,4,6,NA,10))
# Example: no NA
mean_impute(c(2,4,6,8,10))
# Function
mean_mode_impute <- function(x)
{
if(is.numeric(x))
{
# Find mean of x
mean_of_x <- mean(x, na.rm = TRUE)
x <- replace_na(x, mean_of_x)
}
else if(!is.numeric(x))
{
# Find mode of x
mode_of_x <- names(sort(-table(x)))[1]
x <- replace_na(x, mode_of_x)
}
return(x)
}
# Example: NA in numeric vector
mean_mode_impute(c(1,5,16,NA,8))
# Example: NA in non-numeric vector
mean_mode_impute(c("dog", "cat", "dog", "dog", NA, "cat"))
# Example: no NA in vector
mean_mode_impute(c("apple", "orange", "pear", "apple", "melon"))
# Function
viz <- function(d)
{
if((is.numeric(d[[1]])) & (!is.numeric(d[[2]])))
{
d |> ggplot() + geom_boxplot(mapping = aes(x = d[[1]], y = d[[2]]))+labs(x = names(d)[1], y = names(d)[2])
}
else if((!is.numeric(d[[1]])) & (is.numeric(d[[2]])))
{
d |> ggplot() + geom_boxplot(mapping = aes(x = d[[2]], y = d[[1]]))+labs(x = names(d)[2], y = names(d)[1])
}
else
{
print('This function cannot visualize your data.')
}
}
# Example data
df <- read_csv("titanic.csv")
head(df)
# Example: x is numeric, y is categorical
d <- df |> select(Age, Sex)
viz(d)
# Example: x is categorical, y is numeric
d <- df |> select(Sex, Fare)
viz(d)
# Example: both x and y are categorical
d <- df |> select(Sex, Embarked)
viz(d)
