# Mean Impute function from Assignment 13
library(tidyverse)
mean_impute <- function(x)
{
if(is.numeric(x))
{
# Find mean of x
mean_of_x <- mean(x, na.rm = TRUE)
x <- replace_na(x, mean_of_x)
}
return(x)
}
# Function
numeric_impute <- function(d)
{
for (i in 1:length(d))
{
d[[i]] <- mean_impute(d[[i]])
}
return(d)
}
# Read in Titanic df
df <- read_csv("titanic.csv")
# Example
colSums(is.na(df))
# Example: Titanic
numeric_impute(df)
colSums(is.na(df))
# Example: Titanic
d1 <- numeric_impute(df)
colSums(is.na(d1))
# Mean & Mode Impute function from Assignment 13
mean_mode_impute <- function(x)
{
if(is.numeric(x))
{
# Find mean of x
mean_of_x <- mean(x, na.rm = TRUE)
x <- replace_na(x, mean_of_x)
}
else if(!is.numeric(x))
{
# Find mode of x
mode_of_x <- names(sort(-table(x)))[1]
x <- replace_na(x, mode_of_x)
}
return(x)
}
colSums(is.na(df))
# Missing values before imputation
colSums(is.na(df))
# Example: Titanic
d2 <- mean_mode_impute(df)
# Example: Titanic
d2 <- mean_mode_impute(df)
# Example: Titanic
d2 <- mean_mode_impute(df)
# Mode Impute function
mode_impute <- function(x)
{
if(!is.numeric(x))
{
# Find mean of x
mode_of_x <- names(sort(-table(x)))[1]
x <- replace_na(x, mode_of_x)
}
return(x)
}
# Function
impute <- function(d)
{
for (i in 1:length(d))
{
if(is.numeric(d[[i]])){
d[[i]] <- mean_impute(d[[i]])
}
else
d[[i]] <- mode_impute(d[[i]])
}
return(d)
}
# Missing values before imputation
colSums(is.na(df))
# Example: Titanic
d2 <- mean_mode_impute(df)
# Example: Titanic
d2 <- impute(df)
colSums(is.na(d2))
