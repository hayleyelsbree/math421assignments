{
if((is.numeric(d[[1]])) & (!is.numeric(d[[2]])))
{
d |> ggplot() + geom_boxplot(mapping = aes(x = d[[1]], y = d[[2]]))+labs(x = names(d)[1], y = names(d)[2])
}
else if((!is.numeric(d[[1]])) & (is.numeric(d[[2]])))
{
d |> ggplot() + geom_boxplot(mapping = aes(x = d[[2]], y = d[[1]]))+labs(x = names(d)[2], y = names(d)[1])
}
else if((is.numeric(d[[1]])) & (is.numeric(d[[2]])))
{
d |> ggplot() + geom_point(mapping = aes(x = d[[1]], y = d[[2]]))+labs(x = names(d)[1], y = names(d)[2])
}
else if((!is.numeric(d[[1]])) & (!is.numeric(d[[2]])))
{
d |> ggplot() + geom_bar(mapping = aes(x = d[[1]], fill = d[[2]],), position = 'dodge')+labs(x = names(d)[1], fill = names(d)[2])
}
}
# Example: x is numeric, y is categorical
d <- df |> select(Age, Sex)
all_viz(d)
d <- df |> select(Sex, Fare)
all_viz(d)
# Example: 2 continuous
d <- df |> select(Age, Fare)
all_viz(d)
# Example: both x and y are categorical
d <- df |> select(Sex, Embarked)
viz(d)
# Example: 2 categorical
d <- df |> select(Sex, Embarked)
all_viz(d)
